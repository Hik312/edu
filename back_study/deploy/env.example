# 复制为**仓库根的 app.env**（服务器上 /www/wwwroot/python/app.env，即 back_study 的
# 同级），setup.sh 会做并 chmod 600。
# ★ 密钥只填在服务器上的这份文件里：不进仓库、不进聊天、不进命令行历史。
# ★ 这份文件由 start_backend.sh 用 `set -a; . app.env` 加载 —— 不是 systemd 的
#   EnvironmentFile，也不是宝塔「环境变量」那栏，两者都不会真的把值送进进程。

# ---- AI 云端通道（硅基流动 SiliconFlow，OpenAI 兼容协议）----
LLM_PROVIDER=cloud
LLM_BASE_URL=https://api.siliconflow.cn
LLM_API_KEY=sk-替换成你的密钥
# 模型名以硅基流动控制台「模型列表」为准，下面三个是默认值对应的可用模型
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_EMBED_MODEL=BAAI/bge-m3
LLM_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ---- 公开部署安全 ----
# 首个注册者不再自动成 admin（路人先注册会拿到管理员）。
# admin 用 scripts/make_admin.py 预置。
ADMIN_FIRST=0
# 只放行自己的前端来源：Qoder Sites 发布后的地址，多个用逗号分隔。
# 例：CORS_ORIGINS=https://edupath.qoder.site
CORS_ORIGINS=https://替换成你的Sites地址

# ---- 存储 ----
# 线上用 MySQL（2026-11-16 切换；原 JSON 那份用 scripts/dbseed.py --sync /
# --import-json 迁进库）。连不上时服务不会挂：回退到 JSON 文件，并在
# /api/health、/api/storage 里带 degraded 原因 —— 看到 degraded 别忽略，
# 那意味着数据正写进文件，换机器就丢。
STORE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=study
MYSQL_PASSWORD=改成你的库密码
MYSQL_DB=study
# 只想单机跑、不装数据库：改成 STORE=json，上面几行留着无害。
# 算法通关参数（core/algostore）另有 PgSQL 后端可选（ALGO_STORE=pg + psycopg），
# 线上没装也不需要 —— 主数据只走 MySQL。

# ---- 缓存 ----
# 面板装的 Redis（bind 127.0.0.1:6379）。没起也不拦服务，只是少一层缓存。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=改成你的Redis密码