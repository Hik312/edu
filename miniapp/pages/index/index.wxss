/* 首页：一屏能看完「今天要不要学、学多少、去哪学」。
   旧版把 4 个统计做成 4 张大方卡（2×2），光数字就占掉半屏；
   现在压成「一个主数字 + 一条指标带」，信息密度上来了，滚动也短了。 */

/* 未登录引导：一行卡片，整块可点 */
.hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.arrow {
  font-size: 44rpx;
  color: var(--accent);
}

/* ---- 主状态卡：今日待复习 ---- */
.hero {
  background: linear-gradient(135deg, rgba(31, 75, 107, 0.16), rgba(31, 75, 107, 0.04));
  border-color: var(--accent);
}
.heroTop {
  display: flex;
  align-items: flex-end;
}
.heroNum {
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--accent);
}
.heroUnit {
  font-size: 24rpx;
  color: var(--dim);
  margin-left: 14rpx;
  padding-bottom: 8rpx;
}
.heroLine {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--dim);
}
/* 积压说明：比上面那句再淡一档。它是补充信息（解释 400 vs 20），
   不是主状态，不该跟「先复习再学新」同一个视觉权重。 */
.heroLine.dim {
  color: var(--line2);
  font-size: 23rpx;
}
.heroBtn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 14rpx 38rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  font-size: 27rpx;
  line-height: 1.2;
}

/* 指标带：一行四格，数字在上、说明在下 */
.metrics {
  display: flex;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
}
.metric { flex: 1; text-align: center; }
.mv { font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.ml { font-size: 22rpx; color: var(--dim); margin-top: 4rpx; }

/* ---- 区块小标题：左标题右说明 ---- */
.cardHead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* ---- 学习方向：3 列图标网格 ---- */
/* 宽度 = (整行 - 两个间距)/3。旧版用 33.333%-14rpx 再加 21rpx 外边距，
   总和正好 100%，亚像素舍入一超就整列换行（手机上会变成一列一个）。 */
.dirs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.dtile {
  width: calc((100% - 32rpx) / 3);
  margin: 0 16rpx 16rpx 0;
  padding: 20rpx 8rpx 16rpx;
  background: var(--card2);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}
.dtile:nth-child(3n) { margin-right: 0; }
.di { font-size: 48rpx; line-height: 1.2; }
.dn {
  font-size: 22rpx;
  line-height: 1.3;
  margin-top: 8rpx;
  min-height: 58rpx; /* 名称 1~2 行都占两行高，底下的卡数才对得齐 */
  word-break: break-all;
}
.dc { font-size: 20rpx; color: var(--dim); }

/* ---- 分类 → 科目 ---- */
.chips { margin-top: 16rpx; }

/* ---- 零状态按钮 ---- */
/* 「今天都刷完了」时主按钮让位给次要动作：别再用主色召唤点「开始复习」，
   那是个死路（队列是空的），点了只会让用户以为坏了。 */
.heroBtn.ghost {
  background: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
}

/* ---- BKT 掌握度分布条 ---- */
/* 三段按张数分配宽度（flex-grow 由 wxml 传数字），所以某段为 0 时
   flex-grow:0 → 自然不占宽，不需要额外写「隐藏」的判断。 */
.mbar {
  display: flex;
  height: 18rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  overflow: hidden; /* 段与段之间不留缝，靠圆角裁出连续的条 */
}
.seg { flex-basis: 0; }
.sg-weak { background: var(--red); }
.sg-mid { background: var(--amber); }
.sg-strong { background: var(--green); }
.mlegend {
  display: flex;
  margin-top: 14rpx;
}
.mlg {
  display: flex;
  align-items: center;
  flex: 1;
  font-size: 21rpx;
  color: var(--dim);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}
